#!/bin/sh
# S99chat — chatd 总管版（2026-09-11 定版；2026-09-14 加开机预热+readahead）
PLOG=/mnt/data/chat/logs

case "$1" in
  start)
    mkdir -p /tmp/chat
    # 防呆:清掉上次异常退出残留的孤儿 wav/半截回答,日志重开(player 靠 DONE 行计数,残留会错位)
    rm -f /tmp/chat/utt_*.wav /tmp/chat/ask_out.txt /tmp/chat/chatd.lock 2>/dev/null
    : > /tmp/chat/tts_out.log 2>/dev/null
    : > /tmp/chat/llm_out.log 2>/dev/null
    iwconfig wlan0 power off 2>/dev/null
    # 串口防刷屏(2026-09-16 用户实录:内核 warn 直接打断终端输出+切碎汉字)。
    # loglevel 3=仅 err 上串口;全量消息仍进 syslogd 文件供取证
    echo 3 > /proc/sys/kernel/printk 2>/dev/null
    # 顺序大文件读加速（GGUF/mmap fault-around 走 readahead）
    echo 1024 > /sys/block/mmcblk0/queue/read_ahead_kb 2>/dev/null
    # KPU NOC QoS 解锁（2026-09-24：官方 run.sh 同款三条 devmem）。
    # 实测 decode 375→268ms(-28%)；重启失效，开机必打。详见 llm/board/static/noc_poke.sh
    devmem 0x91103028 32 0x30002 2>/dev/null
    devmem 0x91301d0c 32 0 2>/dev/null
    devmem 0x91301d8c 32 0 2>/dev/null
    mkdir -p "$PLOG"
    ps aux | grep "syslog[d]" | grep -q "chat/logs" || {
      kill "$(cat /var/run/syslogd.pid 2>/dev/null)" 2>/dev/null
      sleep 0.3
      syslogd -O "$PLOG/messages" -s 4096 -b 2
    }
    # 开机预热（2026-09-14）：模型 573MB 是 mmap 懒加载，第一问要从 SD
    # 现拉 ~27s（4bit@50MHz 实测 ~21MB/s，HS 模式物理上限）。后台预读
    # 进页缓存后，mmap 缺页变Minor，第一问不再付磁盘钱。TTS kmodel 同理。
    (
      sleep 8
      . /mnt/data/chat/chat.conf 2>/dev/null
      nice -n 19 cat "${LLM_MODEL:-/mnt/data/models/Qwen3-0.6B-Q8_0_q6k_tied.gguf}" > /dev/null 2>&1
      nice -n 19 cat /mnt/data/matcha/*.kmodel > /dev/null 2>&1
    ) &
    (
      sleep 5
      /mnt/data/kpu_llm/chatd start > /tmp/chat/chatd.log 2>&1
    ) &
    ;;
  stop)
    /mnt/data/kpu_llm/chatd stop 2>/dev/null
    sleep 2
    # 防呆(2026-09-15 实录):chatd stop 静默失败会把旧实例连同旧配置留在
    # 后台,新 start 撞单实例锁直接退出,表面"重启成功"实际没换配置
    pkill -x chatd 2>/dev/null
    pkill -x kpud 2>/dev/null
    pkill -x kpu_vits_runner 2>/dev/null
    pkill -x llmd 2>/dev/null
    pkill -f "player.s[h]" 2>/dev/null
    sleep 1
    pgrep -x "chatd|llmd|kpu_vits_runner" >/dev/null && echo "S99chat WARN: process survived stop" >&2
    ;;
  status)
    /mnt/data/kpu_llm/chatd status 2>/dev/null \
      || { pgrep -x chatd >/dev/null && echo "chatd alive (state file n/a)"; } \
      || echo chatd_down
    ;;
esac
